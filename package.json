        "build:elements": "vite build --config vite.elements.config.ts",
        "build:demo": "vite build --config vite.demo.config.ts",
        "storybook": "storybook dev -p 6006",
        "build:storybook": "storybook build -o dist-site",
        "build:site": "pnpm build:storybook && pnpm build:demo",
        "preview": "vite preview",
        "lint": "biome check --error-on-warnings .",
        "typecheck": "tsc -b",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:ssr": "vitest run --project ssr",
        "cem": "cem analyze && node scripts/gen-base-css.mjs",
        "docs": "typedoc",
        "agentcfg": "sh scripts/agentcfg.sh",
        "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
    },
