      "declarations": [
        {
          "kind": "class",
          "description": "Overlapping row of avatars, collapsing any beyond `max` into a trailing\n`+N` chip.\n\nThe avatars are `<hmi-avatar>` elements rendered into this element's own\nshadow root, not slotted children: `size` has to reach every one of them and\n`max` has to hide the rest, and neither is possible on consumer-owned nodes\nwithout mutating light DOM.",
          "name": "HmiAvatarStack",
          "cssParts": [
            {
              "description": "The row.",
              "name": "base"
            },
            {
              "description": "Each rendered `<hmi-avatar>`.",
              "name": "avatar"
            },
            {
              "description": "The `+N` chip, present only when `names` exceeds `max`.",
              "name": "overflow"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "names",
              "type": {
                "text": "readonly string[]"
              },
              "default": "[]",
              "description": "Names to render as overlapping avatars, in display order."
            },
            {
              "kind": "field",
              "name": "max",
              "type": {
                "text": "number"
              },
              "default": "4",
              "description": "Maximum avatars shown before collapsing the rest into a `+N` chip.",
              "attribute": "max"
